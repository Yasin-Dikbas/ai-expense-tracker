# Copy this file to .env and fill in your own values. Never commit .env.

# Gemini API key, free tier, no credit card required (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Random secret used to sign JWT auth tokens issued to the React frontend.
# Generate one with: ruby -rsecurerandom -e "puts SecureRandom.hex(64)"
JWT_SECRET=

# React dev server origin, used for CORS
FRONTEND_URL=http://localhost:5174

# Path to the tesseract binary. Leave empty to use the Windows default
# (C:/Program Files/Tesseract-OCR/tesseract.exe) or whatever "tesseract" resolves
# to on PATH on Linux/macOS.
TESSERACT_PATH=

# SOLID_QUEUE_IN_PUMA is intentionally not used here: the `plugin :solid_queue`
# Puma integration forks a worker process, and fork() isn't available on
# Windows. Run the queue worker in its own terminal instead: bin/jobs
